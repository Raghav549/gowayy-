# The admin and business projects share the same verified existing Gowayy Neon database.
# Configure privately in Vercel project environment settings. Never commit real values.
DATABASE_URL=
AUTH_SECRET=
# Admin project only: a 16+ character one-time credential that rotates the
# blocked legacy admin on its first successful login.
ADMIN_BOOTSTRAP_PASSWORD=
# Either 'admin' or 'business'; separate Vercel projects point to this same root directory.
CONSOLE_MODE=business
