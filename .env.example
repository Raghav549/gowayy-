# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (or attach a Postgres database
# from the Storage tab, which sets DATABASE_URL / POSTGRES_URL for you).

# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, local…).
# Tables are created and demo data is seeded automatically on first request.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Razorpay live/test credentials. Online orders are created only after the
# server verifies the Checkout signature and captured amount. Without these,
# wallet and pay-on-delivery remain available and no fake payment is recorded.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. TLS for the database: disable | require | verify.
# Default: TLS on for remote hosts (no CA pinning), off for localhost.
# DATABASE_SSL=require

# Optional. Max connections per server instance (default 5 on Vercel, 10 locally).
# DATABASE_POOL_MAX=5
